<ui:FluentWindow x:Class="FolderFrame.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="FolderFrame"
        Width="520" Height="640"
        MinWidth="440" MinHeight="460"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="FolderFrame" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/ico.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,20,12">
            <StackPanel>
                <DockPanel Margin="0,4,0,0">
                    <ui:Button DockPanel.Dock="Right" Content="Añadir carpeta" Icon="{ui:SymbolIcon Add20}" Appearance="Primary" Click="AddFolder_Click"/>
                    <TextBlock Text="Carpetas en el escritorio" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="NoFoldersText" Text="Todavía no hay carpetas. Pulsa «Añadir carpeta» para elegir una."
                           Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ItemsControl x:Name="FoldersList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Icon="{ui:SymbolIcon Open20}" ToolTip="Abrir" Tag="{Binding}" Click="OpenFolder_Click" Padding="8,6"/>
                                        <ui:Button Icon="{ui:SymbolIcon Settings20}" ToolTip="Configurar" Tag="{Binding}" Click="ConfigureFolder_Click" Padding="8,6" Margin="4,0,0,0"/>
                                        <ui:Button Icon="{ui:SymbolIcon Delete20}" ToolTip="Quitar del escritorio" Tag="{Binding}" Click="RemoveFolder_Click" Padding="8,6" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Comportamiento" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Text="Abrir las carpetas"/>
                        <TextBlock Text="Se usa en las carpetas nuevas. Cada carpeta puede cambiarlo en su configuración."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DefaultTriggerBox" SelectionChanged="DefaultTriggerBox_SelectionChanged">
                                <ComboBoxItem Content="Al pasar el cursor por encima"/>
                                <ComboBoxItem Content="Con un clic"/>
                                <ComboBoxItem Content="Con doble clic"/>
                            </ComboBox>
                            <ui:Button Grid.Column="1" Content="Aplicar a todas" Margin="8,0,0,0" Click="ApplyTriggerToAll_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <ui:ToggleSwitch x:Name="DoubleClickToHideSwitch" Content="Doble clic en el escritorio para ocultar o mostrar las carpetas" Click="DoubleClickToHide_Click"/>
                </Border>

                <TextBlock Text="Sistema" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <ui:ToggleSwitch x:Name="StartOnLoginSwitch" Content="Iniciar con Windows" Click="StartOnLogin_Click"/>
                        <TextBlock Text="Se abre al iniciar sesión, antes que las apps de inicio normales."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Exportar ajustes" Icon="{ui:SymbolIcon ArrowExport20}" Click="Export_Click"/>
                    <ui:Button Content="Recolocar carpetas" Icon="{ui:SymbolIcon ArrowSync20}" Margin="8,0,0,0" Click="Refresh_Click"
                               ToolTip="Devuelve cada carpeta a su posición guardada"/>
                    <ui:Button Icon="{ui:SymbolIcon Info20}" Margin="8,0,0,0" Click="About_Click" ToolTip="Acerca de"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
