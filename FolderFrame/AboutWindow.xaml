<ui:FluentWindow x:Class="FolderFrame.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Acerca de FolderFrame"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="320" Height="300">
    <StackPanel>
        <ui:TitleBar Title="Acerca de" ShowMaximize="False" ShowMinimize="False"/>
        <StackPanel HorizontalAlignment="Center" Margin="20,8,20,20">
            <Image Source="/ico.png" Height="64" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <TextBlock Text="FolderFrame" FontSize="20" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="VersionTextBlock" Margin="0,4,0,0" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Separator Margin="0,14"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Carpetas para el escritorio de Windows.&#10;Licencia MIT."/>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
